{
  "name": "@honeycrisp/calendar",
  "version": "0.1.0",
  "description": "Apple Calendar write tools over MCP, governed: reads fenced and bounded to one calendar per query, creation provenance-stamped with no attendees by design, deletion captures its own restore recipe first",
  "license": "MIT",
  "type": "module",
  "main": "dist/server.js",
  "mcpName": "io.github.honeycrisp-suite/calendar",
  "bin": {
    "honeycrisp-calendar": "dist/server.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "start": "node dist/server.js",
    "prepublishOnly": "npm run build && npm run test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "apple-calendar",
    "calendar",
    "macos",
    "governed"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/honeycrisp-suite/honeycrisp.git",
    "directory": "packages/calendar"
  },
  "homepage": "https://github.com/honeycrisp-suite/honeycrisp#readme",
  "bugs": {
    "url": "https://github.com/honeycrisp-suite/honeycrisp/issues"
  },
  "dependencies": {
    "@honeycrisp/governed": "^0.1.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
