    "directory": "packages/imessage"
  },
  "homepage": "https://github.com/honeycrisp-suite/honeycrisp#readme",
  "bugs": {
    "url": "https://github.com/honeycrisp-suite/honeycrisp/issues"
  },
  "dependencies": {
    "@honeycrisp/governed": "^0.2.0",
    "better-sqlite3": "^11.10.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
