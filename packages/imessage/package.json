{
  "name": "@honeycrisp/imessage",
  "version": "0.2.0",
  "description": "The iMessage bridge: text your local AI, approve gated actions by replying — owner-only by construction, rate-disciplined, audited",
  "license": "MIT",
  "type": "module",
  "main": "dist/bridge.js",
  "mcpName": "io.github.honeycrisp-suite/imessage",
  "bin": {
    "honeycrisp-imessage": "dist/cli.js"
  },
  "files": [
