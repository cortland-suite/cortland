{
  "name": "@cortland/reminders",
  "version": "0.2.0",
  "description": "Apple Reminders over MCP, governed: reads fenced, creation provenance-stamped, completion gated with native undo, deletion captures its own restore recipe first",
  "license": "MIT",
  "type": "module",
  "main": "dist/server.js",
  "mcpName": "io.github.cortland-suite/reminders",
  "bin": {
    "cortland-reminders": "dist/server.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "start": "node dist/server.js",
    "prepublishOnly": "npm run build && npm run test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "apple-reminders",
    "reminders",
    "macos",
    "governed"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cortland-suite/cortland.git",
    "directory": "packages/reminders"
  },
  "homepage": "https://github.com/cortland-suite/cortland#readme",
  "bugs": {
    "url": "https://github.com/cortland-suite/cortland/issues"
  },
  "dependencies": {
    "@cortland/governed": "^0.2.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
