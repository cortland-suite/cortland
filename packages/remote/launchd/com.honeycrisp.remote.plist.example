<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The Honeycrisp remote gateway: loopback-only MCP over HTTP.
       Reachability beyond this Mac is a tunnel's explicit job
       (e.g. `tailscale serve - -bg 7811`), never this process's. -->
  <key>Label</key>
  <string>com.honeycrisp.remote</string>
  <key>ProgramArguments</key>
  <array>
    <string>REPLACE_NODE_PATH</string>
    <string>REPLACE_CLI_PATH</string>
    <string>serve</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardErrorPath</key>
  <string>/tmp/com.honeycrisp.remote.log</string>
</dict>
</plist>
