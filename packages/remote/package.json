{
  "name": "@cortland/remote",
  "version": "0.2.0",
  "description": "The remote gateway: the suite's governed MCP servers over loopback HTTP with bearer tokens, scopes, and principal-annotated audit — reach them from your own devices via your own tunnel",
  "license": "MIT",
  "type": "module",
  "main": "dist/gateway.js",
  "bin": {
    "cortland-remote": "dist/cli.js"
  },
  "files": [
    "dist",
    "launchd",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm run test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "remote",
    "gateway",
    "streamable-http",
    "macos",
    "governed"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cortland-suite/cortland.git",
    "directory": "packages/remote"
  },
  "homepage": "https://github.com/cortland-suite/cortland#readme",
  "bugs": {
    "url": "https://github.com/cortland-suite/cortland/issues"
  },
  "dependencies": {
    "@cortland/governed": "^0.2.0",
    "@cortland/mail": "^0.2.0",
    "@cortland/context": "^0.2.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "mcpName": "io.github.cortland-suite/remote"
}
